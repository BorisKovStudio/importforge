# Use existing server-side credentials. Never commit real values.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_KEYS_ROTATED=false
# Deployment expected by this hackathon build: importforge-astra.
# Set true only after confirming the existing credentials are safely configured.
MONGODB_URI=
# Exact allowed SRV hostname for your authorized Atlas Sandbox.
MONGODB_EXPECTED_HOST=YOUR-CLUSTER.mongodb.net
# For a standard (non-SRV) URI only: comma-separated sorted host:port list.
MONGODB_EXPECTED_HOSTS=
PORT=4317
